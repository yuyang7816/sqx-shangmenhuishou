<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sqx.app.searchHistory.db.mapper.SearchHistoryMapper">

    <select id="hot" resultType="com.sqx.app.searchHistory.domain.vo.SearchHistoryVo">
        SELECT
            *,
            COUNT(keyword) AS count
        FROM
            search_history
        GROUP BY keyword
        ORDER BY count DESC
    </select>
</mapper>
